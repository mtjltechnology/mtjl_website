# Ambiente de execução
# "development" → mocks ativos (sem chamadas reais a Asaas/Resend)
# "production"  → serviços reais (OBRIGATÓRIO no servidor de produção)
APP_ENV=development

# Banco de dados (só guarda PilotQASubscriber — dado do site, não do produto)
# Desenvolvimento local (SQLite):
DATABASE_URL=sqlite:////private/tmp/mtjl_website.db
# Produção (PostgreSQL):
# DATABASE_URL=postgresql://usuario:senha@localhost:5432/mtjl_website

# Resend — envio de e-mails de contato/notificação
RESEND_API_KEY=your_resend_api_key_here

# Asaas — cobrança das assinaturas PilotQA AI
ASAAS_API_KEY=your_asaas_api_key_here
ASAAS_WEBHOOK_TOKEN=your_asaas_webhook_token_here

# Chave privada RSA (base64) usada pra assinar o token de acesso do PilotQA AI
PILOTQA_JWT_PRIVATE_KEY=your_base64_rsa_private_key_here

# API interna do produto BookingAI Beauty (MTJL_BookingAI_Beauty)
# Local: http://127.0.0.1:8000 (mesma VM, chamada nunca passa pelo Nginx)
# Precisa ser o MESMO valor de MASTER_API_KEY configurado no .env do BookingAI Beauty
BOOKING_INTERNAL_URL=http://127.0.0.1:8000
BOOKING_MASTER_API_KEY=your_master_api_key_here
